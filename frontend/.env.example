# ══════════════════════════════════════════════════════════════════════════════
# Golden Knot — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# All variables must be prefixed with VITE_ to be available in the browser.
# ══════════════════════════════════════════════════════════════════════════════

# ── API ───────────────────────────────────────────────────────────────────────
# REQUIRED — Base URL of the Django backend API (no trailing slash).
# Local development:
VITE_API_URL=http://localhost:8000/api
# Production (set this in Vercel dashboard):
# VITE_API_URL=https://golden-knot-api.onrender.com/api

# ── Google OAuth ──────────────────────────────────────────────────────────────
# REQUIRED for Google sign-in — get from console.cloud.google.com
# → APIs & Services → Credentials → OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=
