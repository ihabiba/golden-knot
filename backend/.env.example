# ══════════════════════════════════════════════════════════════════════════════
# Golden Knot — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Django Core ───────────────────────────────────────────────────────────────
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-50-character-random-secret-key-here

# Set True only in local development. Defaults to False (production-safe).
DEBUG=True

# Comma-separated. .onrender.com is included by default in settings.py.
# For local dev the default is fine — no need to set this.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED — Supabase PostgreSQL connection string
# Special characters in password must be URL-encoded: ! → %21, @ → %40, etc.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production: set to your Vercel URL — e.g. https://golden-knot.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Required if you want Google sign-in to work.
# Get these from console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Image Storage ─────────────────────────────────────────────────────────────
# Set USE_CLOUDINARY=True and fill in credentials for production image hosting.
# Leave False for local development (images saved to backend/media/).
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Legacy S3 (not used — kept for reference) ─────────────────────────────────
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
