# ══════════════════════════════════════════════════════════════════════════════
# Golden Knot — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Django Core ───────────────────────────────────────────────────────────────
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-50-character-random-secret-key-here

# Set True only in local development. Defaults to False (production-safe).
DEBUG=True

# Comma-separated. .onrender.com is included by default in settings.py.
# For local dev the default is fine — no need to set this.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED — Supabase PostgreSQL connection string
# Special characters in password must be URL-encoded: ! → %21, @ → %40, etc.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production: set to your Vercel URL — e.g. https://golden-knot.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Required if you want Google sign-in to work.
# Get these from console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Image Storage ─────────────────────────────────────────────────────────────
# Set USE_CLOUDINARY=True and fill in credentials for production image hosting.
# Leave False for local development (images saved to backend/media/).
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / Password Reset ────────────────────────────────────────────────────
# For production use smtp.gmail.com with an App Password (not your real Gmail password).
# Go to myaccount.google.com → Security → App Passwords → generate one for "Mail".
# For local dev leave EMAIL_BACKEND as console to print emails to terminal instead of sending.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Golden Knot <your-gmail@gmail.com>

# The base URL of your frontend — used to build the password reset link in emails.
# Production: set to your Vercel URL — e.g. https://golden-knot.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Legacy S3 (not used — kept for reference) ─────────────────────────────────
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
